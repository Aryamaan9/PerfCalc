{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/api/analyze",
        "function": "analyzePortfolio"
      },
      {
        "source": "/api/portfolio/save",
        "function": "savePortfolio"
      },
      {
        "source": "/api/portfolio/list",
        "function": "listPortfolios"
      },
      {
        "source": "/api/portfolio/analyze",
        "function": "analyzePortfolioDB"
      },
      {
        "source": "/api/portfolio/advancedList",
        "function": "advancedList"
      },
      {
        "source": "/api/portfolio/advancedSave",
        "function": "advancedSave"
      },
      {
        "source": "/api/portfolio/advancedAnalyze",
        "function": "advancedAnalyze"
      },
      {
        "source": "/api/portfolio/advancedAutoFetch",
        "function": "advancedAutoFetchActions"
      },
      {
        "source": "/api/portfolio/advancedValidate",
        "function": "advancedValidateTickers"
      },
      {
        "source": "/api/portfolio/advancedRawData",
        "function": "advancedRawData"
      },
      {
        "source": "/api/portfolio/advancedRegroup",
        "function": "advancedRegroup"
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": false
    }
  }
}
